# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
build/
dist/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Env & secrets
# NOTE: .env is intentionally committed in this private repo for convenient
# cross-instance resume. If the repo ever goes public or gains collaborators,
# rotate WORKER_API_KEY and CALLBACK_HMAC_SECRET first.
.env.local
*.pem
*.key

# Models & caches (downloaded at runtime, never committed)
data/
models/
cache/
/workspace/ComfyUI/models/**/*.safetensors
/workspace/ComfyUI/models/**/*.ckpt
/workspace/ComfyUI/models/**/*.pt
/workspace/ComfyUI/models/**/*.bin

# ComfyUI runtime artefacts
ComfyUI/input/*
ComfyUI/output/*
!ComfyUI/input/.gitkeep
!ComfyUI/output/.gitkeep

# Logs
*.log
logs/

# Node / frontend
node_modules/
*.tsbuildinfo

