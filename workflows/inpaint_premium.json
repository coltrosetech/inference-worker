{
  "unet_loader": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "flux_fill_dev_fp8.safetensors",
      "weight_dtype": "default"
    }
  },
  "clip_loader": {
    "class_type": "DualCLIPLoader",
    "inputs": {
      "clip_name1": "clip_l.safetensors",
      "clip_name2": "t5xxl_fp8_e4m3fn.safetensors",
      "type": "flux",
      "device": "default"
    }
  },
  "vae_loader": {
    "class_type": "VAELoader",
    "inputs": {"vae_name": "flux_ae.safetensors"}
  },
  "input_image": {
    "class_type": "LoadImage",
    "inputs": {"image": "placeholder.png"}
  },
  "mask_image": {
    "class_type": "LoadImageMask",
    "inputs": {"image": "placeholder_mask.png", "channel": "red"}
  },
  "grow_mask": {
    "class_type": "GrowMask",
    "inputs": {
      "mask": ["mask_image", 0],
      "expand": 8,
      "tapered_corners": true
    }
  },
  "positive_prompt": {
    "class_type": "CLIPTextEncode",
    "inputs": {"text": "", "clip": ["clip_loader", 0]}
  },
  "negative_prompt": {
    "class_type": "CLIPTextEncode",
    "inputs": {"text": "", "clip": ["clip_loader", 0]}
  },
  "pose_preprocessor": {
    "class_type": "DWPreprocessor",
    "inputs": {
      "image": ["input_image", 0],
      "detect_hand": "enable",
      "detect_body": "enable",
      "detect_face": "enable",
      "resolution": 1024
    }
  },
  "pose_controlnet_loader": {
    "class_type": "ControlNetLoader",
    "inputs": {"control_net_name": "flux_controlnet_union_pro_2_fp8.safetensors"}
  },
  "pose_type_setter": {
    "class_type": "SetUnionControlNetType",
    "inputs": {
      "control_net": ["pose_controlnet_loader", 0],
      "type": "openpose"
    }
  },
  "pose_apply": {
    "class_type": "ControlNetApplySD3",
    "inputs": {
      "positive": ["positive_prompt", 0],
      "negative": ["negative_prompt", 0],
      "control_net": ["pose_type_setter", 0],
      "vae": ["vae_loader", 0],
      "image": ["pose_preprocessor", 0],
      "strength": 0.5,
      "start_percent": 0.0,
      "end_percent": 1.0
    }
  },
  "inpaint_cond": {
    "class_type": "InpaintModelConditioning",
    "inputs": {
      "positive": ["positive_prompt", 0],
      "negative": ["negative_prompt", 0],
      "vae": ["vae_loader", 0],
      "pixels": ["input_image", 0],
      "mask": ["grow_mask", 0],
      "noise_mask": true
    }
  },
  "flux_guidance": {
    "class_type": "FluxGuidance",
    "inputs": {
      "conditioning": ["inpaint_cond", 0],
      "guidance": 30.0
    }
  },
  "sampler": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 0,
      "steps": 20,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0,
      "model": ["unet_loader", 0],
      "positive": ["flux_guidance", 0],
      "negative": ["inpaint_cond", 1],
      "latent_image": ["inpaint_cond", 2]
    }
  },
  "vae_decode": {
    "class_type": "VAEDecode",
    "inputs": {"samples": ["sampler", 0], "vae": ["vae_loader", 0]}
  },
  "save": {
    "class_type": "SaveImage",
    "inputs": {"filename_prefix": "output", "images": ["vae_decode", 0]}
  }
}
