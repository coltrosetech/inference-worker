{
  "checkpoint": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {"ckpt_name": "ltxv-13b-0.9.8-distilled-fp8.safetensors"}
  },
  "clip_loader": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "t5xxl_fp8_e4m3fn.safetensors",
      "type": "ltxv",
      "device": "default"
    }
  },
  "input_image": {
    "class_type": "LoadImage",
    "inputs": {"image": "placeholder.png"}
  },
  "positive_prompt": {
    "class_type": "CLIPTextEncode",
    "inputs": {"text": "", "clip": ["clip_loader", 0]}
  },
  "negative_prompt": {
    "class_type": "CLIPTextEncode",
    "inputs": {"text": "blurry, low quality, distorted", "clip": ["clip_loader", 0]}
  },
  "img2video": {
    "class_type": "LTXVImgToVideo",
    "inputs": {
      "positive": ["positive_prompt", 0],
      "negative": ["negative_prompt", 0],
      "vae": ["checkpoint", 2],
      "image": ["input_image", 0],
      "width": 768,
      "height": 512,
      "length": 97,
      "batch_size": 1,
      "strength": 1.0
    }
  },
  "conditioning": {
    "class_type": "LTXVConditioning",
    "inputs": {
      "positive": ["img2video", 0],
      "negative": ["img2video", 1],
      "frame_rate": 24.0
    }
  },
  "scheduler": {
    "class_type": "LTXVScheduler",
    "inputs": {
      "steps": 8,
      "max_shift": 2.05,
      "base_shift": 0.95,
      "stretch": true,
      "terminal": 0.1,
      "latent": ["img2video", 2]
    }
  },
  "guider": {
    "class_type": "CFGGuider",
    "inputs": {
      "model": ["checkpoint", 0],
      "positive": ["conditioning", 0],
      "negative": ["conditioning", 1],
      "cfg": 3.0
    }
  },
  "sampler_select": {
    "class_type": "KSamplerSelect",
    "inputs": {"sampler_name": "euler"}
  },
  "noise": {
    "class_type": "RandomNoise",
    "inputs": {"noise_seed": 42}
  },
  "sampler": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["noise", 0],
      "guider": ["guider", 0],
      "sampler": ["sampler_select", 0],
      "sigmas": ["scheduler", 0],
      "latent_image": ["img2video", 2]
    }
  },
  "vae_decode": {
    "class_type": "VAEDecode",
    "inputs": {"samples": ["sampler", 0], "vae": ["checkpoint", 2]}
  },
  "save": {
    "class_type": "VHS_VideoCombine",
    "inputs": {
      "images": ["vae_decode", 0],
      "frame_rate": 24,
      "loop_count": 0,
      "filename_prefix": "output",
      "format": "video/h264-mp4",
      "pingpong": false,
      "save_output": true
    }
  }
}
