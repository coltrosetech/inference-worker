{
  "unet": {
    "class_type": "UNETLoader",
    "inputs": {"unet_name": "wan2.1_flf2v_720p_14B_fp8_e4m3fn.safetensors", "weight_dtype": "fp8_e4m3fn"}
  },
  "lora": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": {
      "model": ["unet", 0],
      "lora_name": "lightx2v_I2V_14B_480p_cfg_step_distill_rank64_bf16.safetensors",
      "strength_model": 1.0
    }
  },
  "clip": {
    "class_type": "CLIPLoader",
    "inputs": {"clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors", "type": "wan"}
  },
  "vae": {
    "class_type": "VAELoader",
    "inputs": {"vae_name": "wan_2.1_vae.safetensors"}
  },
  "clip_vision": {
    "class_type": "CLIPVisionLoader",
    "inputs": {"clip_name": "clip_vision_h.safetensors"}
  },
  "start_image": {
    "class_type": "LoadImage",
    "inputs": {"image": "placeholder_start.png"}
  },
  "end_image": {
    "class_type": "LoadImage",
    "inputs": {"image": "placeholder_end.png"}
  },
  "clip_vision_start": {
    "class_type": "CLIPVisionEncode",
    "inputs": {"clip_vision": ["clip_vision", 0], "image": ["start_image", 0], "crop": "center"}
  },
  "clip_vision_end": {
    "class_type": "CLIPVisionEncode",
    "inputs": {"clip_vision": ["clip_vision", 0], "image": ["end_image", 0], "crop": "center"}
  },
  "positive_prompt": {
    "class_type": "CLIPTextEncode",
    "inputs": {"text": "", "clip": ["clip", 0]}
  },
  "negative_prompt": {
    "class_type": "CLIPTextEncode",
    "inputs": {"text": "", "clip": ["clip", 0]}
  },
  "model_sampling": {
    "class_type": "ModelSamplingSD3",
    "inputs": {"model": ["lora", 0], "shift": 8.0}
  },
  "flf2v": {
    "class_type": "WanFirstLastFrameToVideo",
    "inputs": {
      "positive": ["positive_prompt", 0],
      "negative": ["negative_prompt", 0],
      "vae": ["vae", 0],
      "width": 720,
      "height": 1280,
      "length": 81,
      "batch_size": 1,
      "clip_vision_start_image": ["clip_vision_start", 0],
      "clip_vision_end_image": ["clip_vision_end", 0],
      "start_image": ["start_image", 0],
      "end_image": ["end_image", 0]
    }
  },
  "sampler": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 0,
      "steps": 30,
      "cfg": 5.0,
      "sampler_name": "uni_pc",
      "scheduler": "simple",
      "denoise": 1.0,
      "model": ["model_sampling", 0],
      "positive": ["flf2v", 0],
      "negative": ["flf2v", 1],
      "latent_image": ["flf2v", 2]
    }
  },
  "vae_decode": {
    "class_type": "VAEDecode",
    "inputs": {"samples": ["sampler", 0], "vae": ["vae", 0]}
  },
  "save": {
    "class_type": "VHS_VideoCombine",
    "inputs": {
      "images": ["vae_decode", 0],
      "frame_rate": 16,
      "loop_count": 0,
      "filename_prefix": "output",
      "format": "video/h264-mp4",
      "pingpong": false,
      "save_output": true
    }
  }
}
