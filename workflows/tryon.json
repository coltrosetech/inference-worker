{
  "checkpoint": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {"ckpt_name": "juggernaut_xl_inpaint.safetensors"}
  },
  "ipadapter_loader": {
    "class_type": "IPAdapterUnifiedLoader",
    "inputs": {
      "model": ["checkpoint", 0],
      "preset": "PLUS (high strength)"
    }
  },
  "input_image": {
    "class_type": "LoadImage",
    "inputs": {"image": "placeholder.png"}
  },
  "reference_image": {
    "class_type": "LoadImage",
    "inputs": {"image": "placeholder_ref.png"}
  },
  "mask_image": {
    "class_type": "LoadImageMask",
    "inputs": {"image": "placeholder_mask.png", "channel": "red"}
  },
  "grow_mask": {
    "class_type": "GrowMask",
    "inputs": {
      "mask": ["mask_image", 0],
      "expand": 12,
      "tapered_corners": true
    }
  },
  "ipadapter_apply": {
    "class_type": "IPAdapterAdvanced",
    "inputs": {
      "model": ["ipadapter_loader", 0],
      "ipadapter": ["ipadapter_loader", 1],
      "image": ["reference_image", 0],
      "weight": 0.9,
      "weight_type": "linear",
      "combine_embeds": "concat",
      "start_at": 0.0,
      "end_at": 1.0,
      "embeds_scaling": "V only"
    }
  },
  "vae_encode_inpaint": {
    "class_type": "VAEEncodeForInpaint",
    "inputs": {
      "pixels": ["input_image", 0],
      "vae": ["checkpoint", 2],
      "mask": ["grow_mask", 0],
      "grow_mask_by": 6
    }
  },
  "positive_prompt": {
    "class_type": "CLIPTextEncode",
    "inputs": {"text": "", "clip": ["checkpoint", 1]}
  },
  "negative_prompt": {
    "class_type": "CLIPTextEncode",
    "inputs": {"text": "blurry, low quality, distorted, deformed", "clip": ["checkpoint", 1]}
  },
  "sampler": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 0,
      "steps": 25,
      "cfg": 7.0,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": 0.9,
      "model": ["ipadapter_apply", 0],
      "positive": ["positive_prompt", 0],
      "negative": ["negative_prompt", 0],
      "latent_image": ["vae_encode_inpaint", 0]
    }
  },
  "vae_decode": {
    "class_type": "VAEDecode",
    "inputs": {"samples": ["sampler", 0], "vae": ["checkpoint", 2]}
  },
  "composite": {
    "class_type": "ImageCompositeMasked",
    "inputs": {
      "destination": ["input_image", 0],
      "source": ["vae_decode", 0],
      "x": 0,
      "y": 0,
      "resize_source": false,
      "mask": ["grow_mask", 0]
    }
  },
  "upscale_loader": {
    "class_type": "UpscaleModelLoader",
    "inputs": {"model_name": "4x-UltraSharp.pth"}
  },
  "hires_upscale": {
    "class_type": "ImageUpscaleWithModel",
    "inputs": {"upscale_model": ["upscale_loader", 0], "image": ["composite", 0]}
  },
  "hires_scale_down": {
    "class_type": "ImageScaleBy",
    "inputs": {"image": ["hires_upscale", 0], "upscale_method": "lanczos", "scale_by": 0.375}
  },
  "hires_encode": {
    "class_type": "VAEEncode",
    "inputs": {"pixels": ["hires_scale_down", 0], "vae": ["checkpoint", 2]}
  },
  "hires_sampler": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 0,
      "steps": 16,
      "cfg": 7.0,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": 0.25,
      "model": ["ipadapter_apply", 0],
      "positive": ["positive_prompt", 0],
      "negative": ["negative_prompt", 0],
      "latent_image": ["hires_encode", 0]
    }
  },
  "hires_decode": {
    "class_type": "VAEDecode",
    "inputs": {"samples": ["hires_sampler", 0], "vae": ["checkpoint", 2]}
  },
  "save": {
    "class_type": "SaveImage",
    "inputs": {"filename_prefix": "output", "images": ["hires_decode", 0]}
  }
}
