{
  "unet_loader": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "flux_kontext_dev_fp8_scaled.safetensors",
      "weight_dtype": "default"
    }
  },
  "clip_loader": {
    "class_type": "DualCLIPLoader",
    "inputs": {
      "clip_name1": "clip_l.safetensors",
      "clip_name2": "t5xxl_fp8_e4m3fn.safetensors",
      "type": "flux",
      "device": "default"
    }
  },
  "vae_loader": {
    "class_type": "VAELoader",
    "inputs": {"vae_name": "flux_ae.safetensors"}
  },
  "input_image": {
    "class_type": "LoadImage",
    "inputs": {"image": "placeholder.png"}
  },
  "scale_input": {
    "class_type": "FluxKontextImageScale",
    "inputs": {"image": ["input_image", 0]}
  },
  "vae_encode": {
    "class_type": "VAEEncode",
    "inputs": {
      "pixels": ["scale_input", 0],
      "vae": ["vae_loader", 0]
    }
  },
  "positive_prompt": {
    "class_type": "CLIPTextEncode",
    "inputs": {"text": "", "clip": ["clip_loader", 0]}
  },
  "negative_prompt": {
    "class_type": "CLIPTextEncode",
    "inputs": {"text": "", "clip": ["clip_loader", 0]}
  },
  "reference_cond": {
    "class_type": "ReferenceLatent",
    "inputs": {
      "conditioning": ["positive_prompt", 0],
      "latent": ["vae_encode", 0]
    }
  },
  "flux_guidance": {
    "class_type": "FluxGuidance",
    "inputs": {
      "conditioning": ["reference_cond", 0],
      "guidance": 2.5
    }
  },
  "sampler": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 0,
      "steps": 20,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0,
      "model": ["unet_loader", 0],
      "positive": ["flux_guidance", 0],
      "negative": ["negative_prompt", 0],
      "latent_image": ["vae_encode", 0]
    }
  },
  "vae_decode": {
    "class_type": "VAEDecode",
    "inputs": {"samples": ["sampler", 0], "vae": ["vae_loader", 0]}
  },
  "save": {
    "class_type": "SaveImage",
    "inputs": {"filename_prefix": "output", "images": ["vae_decode", 0]}
  }
}
