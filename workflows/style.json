{
  "checkpoint": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "Juggernaut_RunDiffusionPhoto2_Lightning_4Steps.safetensors"
    }
  },
  "clip_vision_loader": {
    "class_type": "CLIPVisionLoader",
    "inputs": {
      "clip_name": "CLIP-ViT-H-14-laion2B-s32B-b79K.safetensors"
    }
  },
  "ipa_loader": {
    "class_type": "IPAdapterModelLoader",
    "inputs": {
      "ipadapter_file": "ip-adapter-plus_sdxl_vit-h.safetensors"
    }
  },
  "input_image": {
    "class_type": "LoadImage",
    "inputs": {"image": "placeholder.png"}
  },
  "reference_image": {
    "class_type": "LoadImage",
    "inputs": {"image": "placeholder_ref.png"}
  },
  "vae_encode": {
    "class_type": "VAEEncode",
    "inputs": {"pixels": ["input_image", 0], "vae": ["checkpoint", 2]}
  },
  "positive_prompt": {
    "class_type": "CLIPTextEncode",
    "inputs": {"text": "", "clip": ["checkpoint", 1]}
  },
  "negative_prompt": {
    "class_type": "CLIPTextEncode",
    "inputs": {"text": "blurry, low quality, distorted", "clip": ["checkpoint", 1]}
  },
  "ipa_apply": {
    "class_type": "IPAdapterAdvanced",
    "inputs": {
      "model": ["checkpoint", 0],
      "ipadapter": ["ipa_loader", 0],
      "image": ["reference_image", 0],
      "clip_vision": ["clip_vision_loader", 0],
      "weight": 0.7,
      "weight_type": "style transfer",
      "combine_embeds": "concat",
      "start_at": 0.0,
      "end_at": 1.0,
      "embeds_scaling": "V only"
    }
  },
  "sampler": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 0,
      "steps": 6,
      "cfg": 1.8,
      "sampler_name": "dpmpp_sde",
      "scheduler": "karras",
      "denoise": 0.6,
      "model": ["ipa_apply", 0],
      "positive": ["positive_prompt", 0],
      "negative": ["negative_prompt", 0],
      "latent_image": ["vae_encode", 0]
    }
  },
  "vae_decode": {
    "class_type": "VAEDecode",
    "inputs": {"samples": ["sampler", 0], "vae": ["checkpoint", 2]}
  },
  "save": {
    "class_type": "SaveImage",
    "inputs": {"filename_prefix": "output", "images": ["vae_decode", 0]}
  }
}
