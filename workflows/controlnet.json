{
  "checkpoint": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "Juggernaut_RunDiffusionPhoto2_Lightning_4Steps.safetensors"
    }
  },
  "cn_loader": {
    "class_type": "ControlNetLoader",
    "inputs": {"control_net_name": "cn_union_sdxl_promax.safetensors"}
  },
  "cn_union_type": {
    "class_type": "SetUnionControlNetType",
    "inputs": {
      "control_net": ["cn_loader", 0],
      "type": "auto"
    }
  },
  "input_image": {
    "class_type": "LoadImage",
    "inputs": {"image": "placeholder.png"}
  },
  "preprocessor": {
    "class_type": "AIO_Preprocessor",
    "inputs": {
      "image": ["input_image", 0],
      "preprocessor": "CannyEdgePreprocessor",
      "resolution": 512
    }
  },
  "positive_prompt": {
    "class_type": "CLIPTextEncode",
    "inputs": {"text": "", "clip": ["checkpoint", 1]}
  },
  "negative_prompt": {
    "class_type": "CLIPTextEncode",
    "inputs": {"text": "blurry, low quality, distorted", "clip": ["checkpoint", 1]}
  },
  "cn_apply": {
    "class_type": "ControlNetApplyAdvanced",
    "inputs": {
      "positive": ["positive_prompt", 0],
      "negative": ["negative_prompt", 0],
      "control_net": ["cn_union_type", 0],
      "image": ["preprocessor", 0],
      "strength": 0.8,
      "start_percent": 0.0,
      "end_percent": 1.0,
      "vae": ["checkpoint", 2]
    }
  },
  "vae_encode": {
    "class_type": "VAEEncode",
    "inputs": {"pixels": ["input_image", 0], "vae": ["checkpoint", 2]}
  },
  "sampler": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 0,
      "steps": 6,
      "cfg": 1.8,
      "sampler_name": "dpmpp_sde",
      "scheduler": "karras",
      "denoise": 0.7,
      "model": ["checkpoint", 0],
      "positive": ["cn_apply", 0],
      "negative": ["cn_apply", 1],
      "latent_image": ["vae_encode", 0]
    }
  },
  "vae_decode": {
    "class_type": "VAEDecode",
    "inputs": {"samples": ["sampler", 0], "vae": ["checkpoint", 2]}
  },
  "save": {
    "class_type": "SaveImage",
    "inputs": {"filename_prefix": "output", "images": ["vae_decode", 0]}
  }
}
